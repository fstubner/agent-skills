node_modules/
**/node_modules/
**/artifacts/
playwright-report/
test-results/
*.log
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
*.tsbuildinfo
.turbo/
.cache/

# Scratch research/context and per-project acceptance evidence — v2 already
# ignores both; this covers a `git add -A` run from the repo root too.
.context/
.agent-evidence/
**/.agent-evidence/
# Exception: one v2 fixture intentionally COMMITS a planted, lying report to
# prove accept-check.js ignores on-disk evidence (see
# v2/fixtures/accept-poisoned-report). Already tracked either way, but kept
# here too so it stays add-able after any future git rm --cached.
!v2/fixtures/accept-poisoned-report/.agent-evidence/
!v2/fixtures/accept-poisoned-report/.agent-evidence/**

# Generated by fixture runs (inputs under fixtures/accept-* are kept)
fixtures/**/product-acceptance-report.json
fixtures/**/suite-profile.json
fixtures/**/backend-report.json
fixtures/arch-*/architecture-report.json
fixtures/arch-*/architecture-profile.json
fixtures/eng-*/eng-structure-report.json
fixtures/eng-*/stack-profile.json

