node_modules/
**/node_modules/
**/artifacts/
playwright-report/
test-results/
*.log
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
*.tsbuildinfo
.turbo/
.cache/

# Scratch research/context and per-project acceptance evidence.
.context/
.agent-evidence/
**/.agent-evidence/
# Except under eval/grader-fixtures-v2/, where a recorded gate report is the
# INPUT a grader is tested against, not evidence produced by a run. Ignoring
# it meant zero-count-export-acceptance's grader test passed only on the
# machine that created the file and failed on every clean checkout —
# gateVerdict=missing in CI, green locally.
!eval/grader-fixtures-v2/**/.agent-evidence/
!eval/grader-fixtures-v2/**/.agent-evidence/**
# And under fixtures/replay-*, where a recorded walkthrough run IS the thing
# under test — the fixture exists to prove a fresh log is read and a stale one
# is refused, which needs both logs committed.
!fixtures/replay-*/.agent-evidence/
!fixtures/replay-*/.agent-evidence/**
# Local skill-invocation telemetry (scripts/log-skill-invocation.mjs). Per
# project, never committed — it records what you did, not what the suite is.
.agent-skills-telemetry/
**/.agent-skills-telemetry/
# Exception: one fixture intentionally COMMITS a planted, lying report to
# prove accept-check.js ignores on-disk evidence (see
# fixtures/accept-poisoned-report). Already tracked either way, but kept
# here too so it stays add-able after any future git rm --cached.
!fixtures/accept-poisoned-report/.agent-evidence/
!fixtures/accept-poisoned-report/.agent-evidence/**
