{
  "colors": {
    "neutral": {
      "0": "#ffffff",
      "50": "#f9fafb",
      "100": "#f3f4f6",
      "200": "#e5e7eb",
      "300": "#d1d5db",
      "400": "#9ca3af",
      "500": "#6b7280",
      "600": "#4b5563",
      "700": "#374151",
      "800": "#1f2937",
      "900": "#111827"
    },
    "primary": {
      "base": "#2563eb",
      "hover": "#1d4ed8",
      "light": "#eff6ff",
      "light-border": "#bfdbfe"
    },
    "danger": {
      "base": "#dc2626",
      "hover": "#b91c1c",
      "light": "#fef2f2",
      "light-border": "#fecaca",
      "text": "#d92626"
    },
    "success": {
      "base": "#047857",
      "light": "#ecfdf5"
    },
    "warning": {
      "base": "#b45309",
      "light": "#fffbeb",
      "light-border": "#fde68a"
    },
    "semantic": {
      "background": "#ffffff",
      "text-primary": "#111827",
      "text-secondary": "#1f2937",
      "text-muted": "#6b7280",
      "border": "#e5e7eb",
      "border-subtle": "#eceff3"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "gap": "12px",
    "stack-tight": "12px",
    "stack": "13px",
    "stack-loose": "16px"
  },
  "border": {
    "radius-sm": "6px",
    "radius-md": "8px",
    "radius-full": "999px"
  },
  "typography": {
    "font-family": "Inter, system-ui, sans-serif",
    "heading-1": {
      "size": "28px",
      "line-height": "1.2",
      "margin-bottom": "16px"
    },
    "heading-2": {
      "size": "22px",
      "line-height": "1.25",
      "margin-bottom": "12px"
    },
    "heading-3": {
      "size": "18px",
      "line-height": "1.3",
      "margin-bottom": "12px"
    },
    "body": {
      "size": "14px",
      "line-height": "1.55",
      "margin-bottom": "13px"
    },
    "small": {
      "size": "0.875rem",
      "line-height": "1.5"
    },
    "font-weight-regular": "400",
    "font-weight-semibold": "600"
  },
  "interactive": {
    "focus-outline": "2px solid #2563eb",
    "focus-outline-offset": "2px",
    "cursor-pointer": "pointer"
  },
  "components": {
    "button": {
      "padding": "8px 16px",
      "border-radius": "6px",
      "font-size": "14px"
    },
    "card": {
      "border-radius": "8px",
      "padding": "16px",
      "margin-bottom": "12px"
    },
    "alert": {
      "border-radius": "6px",
      "padding": "12px 15px",
      "font-size": "14px",
      "margin-bottom": "12px"
    },
    "input": {
      "font-size": "14px"
    }
  }
}
