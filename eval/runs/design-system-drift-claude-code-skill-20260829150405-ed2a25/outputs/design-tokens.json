{
  "colors": {
    "brand": "#2563eb",
    "brand-hover": "#1d4ed8",
    "text-main": "#111827",
    "text-secondary": "#1f2937",
    "text-muted": "#6b7280",
    "text-secondary-link": "#374151",
    "danger": "#dc2626",
    "danger-dark": "#b91c1c",
    "danger-light": "#d92626",
    "success": "#047857",
    "surface-base": "#ffffff",
    "surface-secondary": "#f9fafb",
    "border-subtle": "#e5e7eb",
    "border-muted": "#d1d5db",
    "border-light": "#eceff3",
    "alert-error-bg": "#fef2f2",
    "alert-error-border": "#fecaca",
    "alert-error-text": "#d92626",
    "alert-warning-bg": "#fffbeb",
    "alert-warning-border": "#fde68a",
    "alert-warning-text": "#b45309",
    "alert-info-bg": "#eff6ff",
    "alert-info-border": "#bfdbfe",
    "alert-info-text": "#1d4ed8",
    "status-ok-bg": "#ecfdf5",
    "status-ok-text": "#047857",
    "status-late-bg": "#fef2f2",
    "status-late-text": "#dc2727",
    "calendar-grid": "#f0f0f2",
    "calendar-grid-strong": "#e6e6eb",
    "focus-ring": "#2563eb"
  },
  "typography": {
    "fontFamily": "Inter, system-ui, sans-serif",
    "headings": {
      "h1": {
        "fontSize": "28px",
        "lineHeight": 1.2,
        "color": "#111827",
        "marginBottom": "16px"
      },
      "h2": {
        "fontSize": "22px",
        "lineHeight": 1.25,
        "color": "#111827",
        "marginBottom": "12px"
      },
      "h3": {
        "fontSize": "18px",
        "lineHeight": 1.3,
        "color": "#1f2937",
        "marginBottom": "12px"
      }
    },
    "body": {
      "fontSize": "14px",
      "lineHeight": 1.55,
      "color": "#6b7280",
      "marginBottom": "13px"
    },
    "small": {
      "fontSize": "0.875rem",
      "color": "#6c7280"
    }
  },
  "spacing": {
    "xs": "2px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "24px",
    "button-padding-vertical": "8px",
    "button-padding-horizontal": "16px",
    "card-padding": "16px",
    "nav-padding-vertical": "12px",
    "nav-padding-horizontal": "24px",
    "main-padding": "24px",
    "alert-padding-vertical": "12px",
    "alert-padding-horizontal": "15px",
    "table-padding": "12px",
    "table-cell-vertical": "13px",
    "pill-padding-vertical": "2px",
    "pill-padding-horizontal": "10px"
  },
  "layout": {
    "max-width": "960px",
    "gap": "12px"
  },
  "border": {
    "radius-sm": "6px",
    "radius-md": "8px",
    "radius-full": "999px"
  },
  "focus": {
    "outline": "2px solid #2563eb",
    "outline-offset": "2px"
  }
}
