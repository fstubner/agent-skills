{
  "name": "fstubner/agent-skills",
  "suiteVersionFile": "VERSION",
  "defaultSkill": "product-build",
  "_defaultSkillNote": "Not a pipeline head — every skill below fires independently on its own trigger. This is only the suggested starting point when a request is greenfield/ambiguous and no single skill's trigger clearly applies yet.",
  "evidenceDir": ".agent-evidence",
  "harnessPaths": {
    "cursor": "~/.cursor/skills",
    "claude": "~/.claude/skills",
    "codex": "~/.agents/skills"
  },
  "skills": [
    { "id": "product-build", "role": "Dispatcher — routes a greenfield/ambiguous request to whichever skills apply" },
    { "id": "product-management", "role": "PRODUCT.md contract interview" },
    { "id": "systems-architecture", "role": "Parts, boundaries, trust" },
    { "id": "frontend", "role": "Stack, structure, design, and UX" },
    { "id": "backend-engineering", "role": "Trusted-side laws" },
    { "id": "product-acceptance", "role": "Independent acceptance gate" },
    { "id": "ai-prose-slop", "role": "Prose slop editor/detector" },
    { "id": "mental-models", "role": "Reasoning lens catalog + triage guide" },
    { "id": "the-skeptic", "role": "Persona — demands evidence before accepting a claim or plan" },
    { "id": "the-systems-thinker", "role": "Persona — maps interconnections and feedback loops before fixing" },
    { "id": "the-pragmatist", "role": "Persona — smallest thing that ships, tradeoffs named not hidden" },
    { "id": "the-explorer", "role": "Persona — generates genuinely different approaches before judging any" }
  ],
  "artifacts": [
    {
      "id": "product-contract",
      "kind": "document",
      "file": "PRODUCT.md",
      "producer": "product-management",
      "consumers": ["systems-architecture", "frontend", "backend-engineering", "product-acceptance"],
      "acceptanceGated": true,
      "requiredWhen": "always",
      "requiredHeadings": ["Purpose", "Users", "Success", "MVP", "Constraints"]
    },
    {
      "id": "architecture-doc",
      "kind": "document",
      "file": "ARCHITECTURE.md",
      "producer": "systems-architecture",
      "consumers": ["backend-engineering", "product-acceptance"],
      "acceptanceGated": true,
      "requiredWhen": "multi_part",
      "requiredHeadings": ["Parts", "Boundaries", "Trust"]
    },
    {
      "id": "design-direction",
      "kind": "document",
      "file": "design-direction.md",
      "producer": "frontend",
      "consumers": ["product-acceptance"],
      "acceptanceGated": true,
      "requiredWhen": "frontend_present"
    },
    {
      "id": "ux-walkthrough",
      "kind": "document",
      "file": "ux-walkthrough.md",
      "producer": "frontend",
      "consumers": ["product-acceptance"],
      "acceptanceGated": true,
      "requiredWhen": "frontend_present"
    },
    {
      "id": "stack-decision",
      "kind": "document",
      "file": "stack-decision.md",
      "producer": "frontend",
      "consumers": ["product-acceptance"],
      "acceptanceGated": false,
      "requiredWhen": "never",
      "note": "Written only when the stack was open to choose (frontend/SKILL.md). Not acceptance-gated: an existing-stack project legitimately has no stack-decision.md."
    },
    {
      "id": "design-tokens",
      "kind": "document",
      "file": "design-tokens.json",
      "producer": "frontend",
      "consumers": ["product-acceptance"],
      "acceptanceGated": false,
      "requiredWhen": "never",
      "note": "Consumed directly by frontend's own checker (F-tokens-contrast), which is itself acceptance-gated via frontend-report. Listed here so it isn't undocumented, not double-gated."
    },
    {
      "id": "architecture-report",
      "kind": "report",
      "file": ".agent-evidence/architecture-report.json",
      "producer": "systems-architecture",
      "producerScript": "systems-architecture/scripts/check-architecture.js",
      "schema": "core/schemas/check-report.schema.json",
      "consumers": ["product-acceptance"],
      "acceptanceGated": true,
      "requiredWhen": "multi_part"
    },
    {
      "id": "frontend-report",
      "kind": "report",
      "file": ".agent-evidence/frontend-report.json",
      "producer": "frontend",
      "producerScript": "frontend/scripts/check-frontend.js",
      "schema": "core/schemas/check-report.schema.json",
      "consumers": ["product-acceptance"],
      "acceptanceGated": true,
      "requiredWhen": "frontend_present"
    },
    {
      "id": "backend-report",
      "kind": "report",
      "file": ".agent-evidence/backend-report.json",
      "producer": "backend-engineering",
      "producerScript": "backend-engineering/scripts/check-backend.js",
      "schema": "core/schemas/check-report.schema.json",
      "consumers": ["product-acceptance"],
      "acceptanceGated": true,
      "requiredWhen": "server_present"
    },
    {
      "id": "acceptance-report",
      "kind": "report",
      "file": ".agent-evidence/acceptance-report.json",
      "producer": "product-acceptance",
      "producerScript": "product-acceptance/scripts/accept-check.js",
      "schema": "core/schemas/check-report.schema.json",
      "consumers": [],
      "acceptanceGated": false,
      "requiredWhen": "always"
    },
    {
      "id": "prose-report",
      "kind": "report",
      "file": null,
      "producer": "ai-prose-slop",
      "producerScript": "ai-prose-slop/scripts/check-prose.js",
      "schema": "core/schemas/check-report.schema.json",
      "consumers": [],
      "acceptanceGated": false,
      "requiredWhen": "never",
      "note": "Invoked directly via its own CLI (targets as positional args, optional --report <path>), not through --root/evidenceDir like the registry-driven checkers. No default file: null reflects that."
    }
  ]
}
