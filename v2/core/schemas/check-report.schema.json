{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent-skills unified check report",
  "description": "Every checker in the suite (architecture, frontend, backend, acceptance, prose) emits exactly this shape.",
  "type": "object",
  "required": ["schemaVersion", "skill", "generatedAt", "verdict", "checks"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "root": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["SHIP", "CONDITIONAL", "BLOCK"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "not_evaluated"] },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
