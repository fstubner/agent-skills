#!/usr/bin/env node
'use strict';
// Blocks a commit whose STAGED content contains a secret, via `gitleaks
// protect --staged` — a real, maintained secret-detection tool (hundreds of
// provider-specific rules, entropy checks, redaction built in), the same
// "shell out to the real tool, don't reimplement its detection logic"
// choice this suite already made for ai-prose-slop and vale. Node, not a
// native sh/ps1 script: Node is already a de facto prerequisite for the
// coding-agent harnesses this suite targets (Claude Code CLI itself is
// npm-distributed), so there's nothing to gain by avoiding it here, and a
// second hand-maintained implementation is a second thing that can drift.
//
// Runs gitleaks TWICE — once with its own default ruleset, once with
// core/gitleaks-extra.toml (a couple of provider prefixes the default
// ruleset doesn't cover, verified empirically — see that file's header)
// — and merges both result sets. `[extend] useDefault = true` on top of a
// custom config was tried first and empirically did not merge; two runs
// does.
//
// Install (opt-in per clone; git config is not committed, so this never
// activates for a contributor who hasn't run it):
//   git config core.hooksPath scripts/git-hooks
//
// If gitleaks isn't installed, this WARNS and ALLOWS the commit — a git
// hook that hard-blocks every commit because an opt-in convenience tool
// is missing is a worse failure mode than an unscanned commit. Contrast
// with backend-engineering's B-client-secrets check (product-acceptance
// context), which correctly treats "gitleaks missing" as not_evaluated —
// a report is never trusted as done just because a check didn't run, but
// a LOCAL git hook blocking someone's entire workflow over a missing
// convenience binary is a different tradeoff than a ship-readiness report.

const { spawnSync } = require('child_process');
const fs = require('fs');
const os = require('os');
const path = require('path');

const extraConfig = path.join(__dirname, '..', '..', 'core', 'gitleaks-extra.toml');
// Gitleaks' own default ruleset, passed EXPLICITLY. Without --config, gitleaks
// auto-discovers <target>/.gitleaks.toml, so a committed
// `[allowlist] paths = [".*"]` switches the scan off — see that file's header,
// where a live ghp_ token went from fail to pass purely by adding it.
// check-backend.js has always passed this; this hook did not, so the bypass
// worked locally. It matters here for the same reason it matters there: the
// thing being scanned is also the thing that can write the config, and an
// agent that wants its commit to pass can write both.
const defaultConfig = path.join(__dirname, '..', '..', 'core', 'gitleaks-defaults.toml');
const LEAKS_FOUND_CODE = 2; // distinct from gitleaks' own fixed exit 1 for an internal error

function installHint() {
  if (process.platform === 'win32') return 'winget install Gitleaks.Gitleaks';
  if (process.platform === 'darwin') return 'brew install gitleaks';
  return 'See https://github.com/gitleaks/gitleaks#installing';
}

function isGitleaksOnPath() {
  const probe = spawnSync('gitleaks', ['version'], { encoding: 'utf8' });
  return !probe.error && probe.status === 0;
}

// Runs one gitleaks pass and returns { leaks, crashed, stderr }. `crashed`
// is true only for a genuine gitleaks failure (bad config, unreadable
// path) — never for "leaks found," which is the expected non-zero case.
function runGitleaksPass(configArgs, tmpDir, label) {
  const reportPath = path.join(tmpDir, `report-${label}.json`);
  const result = spawnSync('gitleaks', [
    'protect', '--staged', '--no-banner', '--redact',
    // An inline `gitleaks:allow` comment is written by whoever is committing.
    // Honouring it here would let the commit under inspection wave itself
    // through — same reasoning as check-backend.js, which also passes this.
    '--ignore-gitleaks-allow',
    '--report-format', 'json', '--report-path', reportPath,
    '--exit-code', String(LEAKS_FOUND_CODE),
    ...configArgs,
  ], { encoding: 'utf8' });

  if (result.error) {
    return { leaks: [], crashed: true, stderr: result.error.message };
  }
  if (result.status !== 0 && result.status !== LEAKS_FOUND_CODE) {
    return { leaks: [], crashed: true, stderr: result.stderr || '(no stderr)' };
  }
  try {
    return { leaks: JSON.parse(fs.readFileSync(reportPath, 'utf8')), crashed: false };
  } catch {
    // No report file on a clean run is gitleaks' own normal behavior.
    if (result.status === LEAKS_FOUND_CODE) {
      return { leaks: [], crashed: true, stderr: 'gitleaks reported leaks but its report file was unreadable' };
    }
    return { leaks: [], crashed: false };
  }
}

// A missing gitleaks skips the SECRET scan only — it must not also skip the
// structural checks below, which have no external dependency.
if (isGitleaksOnPath()) {
  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'pre-commit-gitleaks-'));
  let passes;
  try {
    passes = [
      runGitleaksPass(['--config', defaultConfig], tmpDir, 'default'),
      runGitleaksPass(['--config', extraConfig], tmpDir, 'extra'),
    ];
  } finally {
    fs.rmSync(tmpDir, { recursive: true, force: true });
  }

  const crashedPass = passes.find((p) => p.crashed);
  if (crashedPass) {
    console.error(`pre-commit: gitleaks did not complete normally: ${crashedPass.stderr}`);
    process.exit(1);
  }

  const leaks = passes.flatMap((p) => p.leaks);
  if (leaks.length > 0) {
    console.error('pre-commit: secret(s) staged (via gitleaks):');
    for (const leak of leaks) {
      console.error(`  ${leak.File}:${leak.StartLine} [${leak.RuleID}]`);
    }
    console.error('Remove the secret (and rotate it if already committed elsewhere) before committing.');
    console.error('If this is a genuine false positive, commit with --no-verify and open an issue.');
    process.exit(1);
  }
} else {
  console.error('pre-commit: gitleaks is not on PATH — secret scanning skipped, commit allowed.');
  console.error(`Install it for real protection: ${installHint()}`);
}

// ---------- Structural checks on STAGED files only ----------
// code-smells and code-organization run with --files, scoped to what this
// commit actually touches. Scoping is not a convenience: a whole-repo scan
// blocks the very first commit on any codebase that isn't already green, and
// a hook that blocks work unrelated to the change gets bypassed with
// --no-verify or uninstalled, which is strictly worse than no hook. Same
// reasoning as `gitleaks protect --staged` above.
//
// Note the asymmetry with product-acceptance, which deliberately re-runs
// these checkers across the WHOLE project: a ship-readiness verdict must not
// be scoped to one commit's diff. This hook is a fast local guard, not a gate.

const repoRoot = path.join(__dirname, '..', '..');

// Only checkers that support --files belong here. A checker without it would
// scan the whole repo on every commit and reintroduce exactly the
// block-the-first-commit problem --files exists to solve, so this list is
// deliberately explicit rather than derived from "every skill with a script".
const SCOPED_CHECKERS = [
  { skill: 'code-smells', script: path.join(repoRoot, 'code-smells', 'scripts', 'check-smells.js') },
  { skill: 'code-organization', script: path.join(repoRoot, 'code-organization', 'scripts', 'check-organization.js') },
  { skill: 'data-modeling', script: path.join(repoRoot, 'data-modeling', 'scripts', 'check-migrations.js') },
];

function stagedFiles() {
  // ACMR: added/copied/modified/renamed. Deletions are excluded — a deleted
  // file has no content to check and naming it would just be dropped anyway.
  const r = spawnSync('git', ['diff', '--cached', '--name-only', '--diff-filter=ACMR'], { encoding: 'utf8' });
  if (r.error || r.status !== 0) return null;
  return r.stdout.split('\n').map((s) => s.trim()).filter(Boolean);
}

// Paths whose CONTENT is deliberately defective and must stay that way.
// fixtures/ exists so a checker can be proven to catch a circular import, a
// 400-line file, a destructive migration. Running the same checkers over it
// blocks the commit that adds a block-fixture — the hook forbidding the test
// data that proves the hook works. Caught the first time a minified-bundle
// fixture was added, 2026-08-02.
//
// Only these checkers skip it. gitleaks above still scans fixtures/, because
// a REAL credential committed there is a real leak no matter what the
// directory is for.
const CONTENT_EXEMPT = [/^fixtures\//];

const staged = stagedFiles();
if (staged === null) {
  console.error('pre-commit: could not list staged files; structural checks skipped.');
  process.exit(0);
}
const checkable = staged.filter((f) => !CONTENT_EXEMPT.some((re) => re.test(f)));
if (checkable.length === 0) process.exit(0);

// Check the index snapshot, never the mutable working tree. Otherwise a file
// can be staged clean, changed to unsafe content (or vice versa), and the hook
// reports on content different from the commit it is deciding about.
const stagedRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'pre-commit-index-'));
const prefix = stagedRoot.endsWith(path.sep) ? stagedRoot : stagedRoot + path.sep;
const checkout = spawnSync('git', ['checkout-index', '--all', '--force', `--prefix=${prefix}`], {
  cwd: repoRoot, encoding: 'utf8',
});
if (checkout.error || checkout.status !== 0) {
  fs.rmSync(stagedRoot, { recursive: true, force: true });
  console.error(`pre-commit: could not materialize staged index: ${checkout.stderr || checkout.error?.message}`);
  process.exit(1);
}

const fileListPath = path.join(stagedRoot, '.pre-commit-scan-set');
fs.writeFileSync(fileListPath, checkable.join('\n'));

let blocked = false;
try {
for (const { skill, script } of SCOPED_CHECKERS) {
  // The hook can be copied into a project that doesn't vendor the checkers.
  // Missing checker warns rather than blocks, same tradeoff as missing gitleaks.
  if (!fs.existsSync(script)) {
    console.error(`pre-commit: ${skill} checker not found at ${script} — skipped.`);
    continue;
  }
  // The scan set goes via a file, not the command line. Passing 2,400
  // staged paths as one comma-joined argument hit ENAMETOOLONG and every
  // scoped checker reported "could not run — skipped": the gate stopped
  // running on precisely the largest commits, and said so in a warning
  // nobody reads. Observed on a real commit in this repository.
  const r = spawnSync(process.execPath, [script, '--root', stagedRoot, '--files-from', fileListPath], { encoding: 'utf8' });
  if (r.error) {
    console.error(`pre-commit: ${skill} could not run (${r.error.message}) — skipped.`);
    continue;
  }
  let report;
  try {
    report = JSON.parse(r.stdout);
  } catch {
    console.error(`pre-commit: ${skill} emitted unparseable output — skipped.`);
    continue;
  }
  const failed = (report.checks || []).filter((c) => c.status === 'fail');
  if (failed.length > 0) {
    blocked = true;
    console.error(`pre-commit: ${skill} found problem(s) in staged files:`);
    for (const c of failed) console.error(`  [${c.id}] ${c.detail}`);
  }
}
} finally {
  fs.rmSync(stagedRoot, { recursive: true, force: true });
}

if (blocked) {
  console.error('');
  console.error('These are scoped to the files you staged, not the whole repo.');
  console.error('Fix them, or commit with --no-verify if this is a deliberate exception.');
  process.exit(1);
}

process.exit(0);
